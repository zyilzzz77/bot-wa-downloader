# API Key untuk neoxr API (YouTube, Google Drive, TikTok, Instagram, Threads & Terabox)
# Dapatkan dari: https://api.neoxr.eu
NEOXR_API_KEY=your_neoxr_api_key_here

# Project API key LYDEV Pay untuk fitur QRIS (command: qris <nominal>)
# Format: lypay-... — buat di dashboard LYDEV Pay, tab Project & API.
LYDEV_API_KEY=your_lydev_api_key_here

# (Opsional) Nomor HP untuk auto-pairing — dikosongin, pakai command manual:
#   docker compose exec botgodownloader ./botgodownloader -pair 628xxx
# PHONE_NUMBER=6281234567890

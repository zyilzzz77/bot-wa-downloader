# API Key untuk neoxr API (TikTok & Instagram downloader)
# Dapatkan dari: https://api.neoxr.eu
NEOXR_API_KEY=your_neoxr_api_key_here

# (Opsional) Nomor HP untuk auto-pairing — dikosongin, pakai command manual:
#   docker compose exec botgodownloader ./botgodownloader -pair 628xxx
# PHONE_NUMBER=6281234567890
